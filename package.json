{
  "name": "pilates-rezervasyon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3040",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.mjs\"",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "check:production": "node scripts/check-production-env.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "db:reset": "node scripts/reset-local-db.mjs",
    "db:cleanup": "node --conditions react-server --env-file-if-exists=.env.local --import tsx scripts/cleanup.ts",
    "ios:sync": "cap sync ios",
    "ios:open": "cap open ios",
    "mail:retry": "node --conditions react-server --env-file-if-exists=.env.local --import tsx scripts/retry-emails.ts"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@electric-sql/pglite": "^0.5.8",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.8",
    "nodemailer": "^10.0.14",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "tsx": "^4.23.15",
    "typescript": "6.0.3"
  }
}
